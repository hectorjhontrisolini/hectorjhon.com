{
  "title": "SAT Hidrológico - Monitoreo en Tiempo Real",
  "uid": "sat-hidrologico-main",
  "tags": ["hidrologia", "sat", "riesgo-desastres"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Nivel de río (m) por estación",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "InfluxDB-Hidrologia" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2.0 },
              { "color": "red", "value": 2.5 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"hidrologia\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"lectura_hidrologica\") |> filter(fn: (r) => r._field == \"nivel_m\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false) |> yield(name: \"nivel_m\")"
        }
      ]
    },
    {
      "id": 2,
      "title": "Batería de estaciones (%)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "InfluxDB-Hidrologia" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 40 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"hidrologia\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"lectura_hidrologica\") |> filter(fn: (r) => r._field == \"bateria_pct\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false) |> yield(name: \"bateria_pct\")"
        }
      ]
    },
    {
      "id": 3,
      "title": "Calidad de señal (RSSI dBm)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "InfluxDB-Hidrologia" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": -100 },
              { "color": "red", "value": -110 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"hidrologia\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"lectura_hidrologica\") |> filter(fn: (r) => r._field == \"rssi\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false) |> yield(name: \"rssi\")"
        }
      ]
    },
    {
      "id": 4,
      "title": "Alertas activas: nivel_m > 2.5",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "Postgres-Hydro" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 2.5 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "nivel_m" },
            "properties": [{ "id": "thresholds" }, { "id": "custom.displayMode", "value": "color-background" }]
          }
        ]
      },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT fecha_utc AS \"time\", estacion_id, nivel_m, bateria_pct, rssi, fuente_comunicacion FROM fact_hydrology WHERE nivel_m > 2.5 ORDER BY fecha_utc DESC LIMIT 100"
        }
      ]
    },
    {
      "id": 5,
      "title": "Anomalías detectadas (últimas 24h)",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "Postgres-Hydro" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT fecha_utc AS \"time\", estacion_id, tipo_anomalia, severidad, detalle FROM anomalias WHERE detectado_at > now() - interval '24 hours' ORDER BY detectado_at DESC LIMIT 200"
        }
      ]
    }
  ]
}
